{
  "buildCommand": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});for(const f of ['index.html','app.js','config.js','icons.js','styles.css','manifest.webmanifest','service-worker.js'])fs.copyFileSync(f,'dist/'+f)\"",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
